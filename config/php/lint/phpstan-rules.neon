# Custom rules for what Rector, PHP-CS-Fixer and PHPStan do not check — see PHP.md "Custom PHPStan rules".
# A threshold (80, 2, 1000, 50, 3) is the constructor default of the rule class in lint/rules/.
rules:
    # Naming — PHP.md 1.1 / 1.2 / 1.3
    - Lint\Rules\ValidClassNameRule
    - Lint\Rules\CamelCapsMethodNameRule
    - Lint\Rules\UpperCaseConstantNameRule
    - Lint\Rules\PropertyNamingRule
    - Lint\Rules\ParameterNamingRule
    - Lint\Rules\VariableNamingRule

    # Line length, comment language — PHP.md 2.3 (80), 3.5
    - Lint\Rules\LineLengthRule
    - Lint\Rules\NonEnglishCommentRule

    # Nesting, file length — PHP.md 4.2 (2 levels), 4.6 (1000 lines)
    - Lint\Rules\NestingDepthRule
    - Lint\Rules\FileLengthRule

    # Function length, parameter count — CLEAN-FUNC-SIZE (50), CLEAN-PARAMS (3)
    - Lint\Rules\FunctionLengthRule
    - Lint\Rules\ParameterCountRule

    # Security — WebSecurityRules.md 1 / 5 / 6
    - Lint\Rules\RawSqlInterpolationRule
    - Lint\Rules\UnescapedOutputRule
    - Lint\Rules\UserInputInPathRule
