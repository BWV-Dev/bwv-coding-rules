{
  "permissions": {
    "defaultMode": "auto",
    "disableBypassPermissionsMode": "disable",
    "ask": [
      "Bash(git push:*)",
      "PowerShell(git push:*)",
      "Bash(gh pr create:*)",
      "PowerShell(gh pr create:*)",
      "Bash(rm *)",
      "PowerShell(Remove-Item:*)",
      "PowerShell(rm *)",
      "PowerShell(del *)",
      "PowerShell(erase *)",
      "PowerShell(ri *)",
      "PowerShell(rd *)",
      "PowerShell(rmdir *)",
      "Bash(git reset --hard:*)",
      "PowerShell(git reset --hard:*)",
      "Bash(git push --force:*)",
      "PowerShell(git push --force:*)",
      "Edit(.github/workflows/**)",
      "Edit(**/deploy*.yml)",
      "Edit(Dockerfile*)",
      "Edit(docker-compose*.yml)",
      "Bash(npm install:*)",
      "PowerShell(npm install:*)",
      "Bash(npm remove:*)",
      "PowerShell(npm remove:*)",
      "Bash(npm uninstall:*)",
      "PowerShell(npm uninstall:*)",
      "Bash(pnpm add:*)",
      "Bash(pnpm remove:*)",
      "PowerShell(pnpm add:*)",
      "PowerShell(pnpm remove:*)",
      "Bash(yarn add:*)",
      "PowerShell(yarn add:*)",
      "Bash(yarn remove:*)",
      "PowerShell(yarn remove:*)",
      "WebFetch",
      "Bash(curl *)",
      "PowerShell(curl *)",
      "Bash(wget *)",
      "PowerShell(wget *)",
      "PowerShell(Invoke-WebRequest:*)",
      "PowerShell(Invoke-RestMethod:*)",
      "Edit(.claude/settings.json)",
      "Edit(.claude/settings.local.json)",
      "Edit(.claude/hooks/**)",
      "Edit(~/.claude/settings.json)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.key)",
      "Read(./**/*.pem)",
      "Read(./**/secrets/**)",
      "Read(./**/credentials/**)",
      "Read(./**/config/credentials.json)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Bash(git push --force * main)",
      "PowerShell(git push --force * main)",
      "Bash(git push --force * develop)",
      "PowerShell(git push --force * develop)",
      "Bash(git push -f * main)",
      "PowerShell(git push -f * main)",
      "Bash(git push -f * develop)",
      "PowerShell(git push -f * develop)",
      "Bash(git push --force-with-lease * main)",
      "PowerShell(git push --force-with-lease * main)",
      "Bash(git push --force-with-lease * develop)",
      "PowerShell(git push --force-with-lease * develop)",
      "Bash(git branch -D main)",
      "PowerShell(git branch -D main)",
      "Bash(git branch -D develop)",
      "PowerShell(git branch -D develop)",
      "Bash(git branch --delete --force main)",
      "PowerShell(git branch --delete --force main)",
      "Bash(git branch --delete --force develop)",
      "PowerShell(git branch --delete --force develop)",
      "Bash(git tag -d *)",
      "PowerShell(git tag -d *)",
      "Bash(git tag --delete *)",
      "PowerShell(git tag --delete *)",
      "Bash(aws iam *)",
      "PowerShell(aws iam *)",
      "Bash(infisical export*)",
      "PowerShell(infisical export*)",
      "Bash(infisical secrets*)",
      "PowerShell(infisical secrets*)",
      "Bash(printenv*)",
      "Bash(env)",
      "PowerShell(Get-ChildItem Env*)",
      "PowerShell(gci Env*)",
      "PowerShell(dir Env*)",
      "PowerShell(ls Env*)",
      "PowerShell(Get-Item Env*)",
      "Bash(findstr * .env*)",
      "PowerShell(findstr * .env*)",
      "PowerShell(Select-String * .env*)",
      "PowerShell(Get-Content *.env*)",
      "PowerShell(gc *.env*)",
      "PowerShell(type *.env*)"
    ]
  },
  "autoMode": {
    "environment": [
      "$defaults"
    ],
    "allow": [
      "$defaults"
    ],
    "soft_deny": [
      "$defaults"
    ],
    "hard_deny": [
      "$defaults"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "excludedCommands": [
      "docker *"
    ],
    "filesystem": {
      "denyRead": [
        "~/.aws/credentials",
        "~/.ssh"
      ]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "codeload.github.com",
        "objects.githubusercontent.com",
        "registry.npmjs.org",
        "*.npmjs.org",
        "registry.yarnpkg.com"
      ]
    }
  }
}